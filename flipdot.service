[Unit]
Description=Flipdot board server
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=30
WorkingDirectory=%h/Documents/Programming/flipdisk
ExecStart=/usr/bin/python3 %h/Documents/Programming/flipdisk/server.py --port 8080
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
