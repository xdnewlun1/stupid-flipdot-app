+/* mapper 3 (CNROM): fixed PRG like NROM, 8 KB CHR ROM bank chosen by any write to $8000-$FFFF */
+static void mapper3_init(mapper3_t *mapper, agnes_t *agnes) {
+    mapper->agnes = agnes;
+    mapper->prg_bank_offsets[0] = 0;
+    mapper->prg_bank_offsets[1] = agnes->gamepack.prg_rom_banks_count > 1 ? (16 * 1024) : 0;
+    mapper->chr_bank_offset = 0;
+}
+
+static uint8_t mapper3_read(mapper3_t *mapper, uint16_t addr) {
+    const gamepack_t *gp = &mapper->agnes->gamepack;
+    if (addr < 0x2000) {
+        return gp->chr_rom_banks_count ? gp->data[gp->chr_rom_offset + mapper->chr_bank_offset + addr] : 0;
+    } else if (addr >= 0x8000) {
+        return gp->data[gp->prg_rom_offset + mapper->prg_bank_offsets[(addr >> 14) & 0x1] + (addr & 0x3fff)];
+    }
+    return 0;
+}
+
+static void mapper3_write(mapper3_t *mapper, uint16_t addr, uint8_t val) {
+    int banks = mapper->agnes->gamepack.chr_rom_banks_count;
+    if (addr >= 0x8000 && banks > 0) {
+        mapper->chr_bank_offset = (val % banks) * (8 * 1024);
+    }
+}
+
+/* mapper 7 (AxROM): 32 KB PRG bank and single-screen nametable chosen by writes to $8000-$FFFF, CHR RAM */
+static void mapper7_init(mapper7_t *mapper, agnes_t *agnes) {
+    mapper->agnes = agnes;
+    mapper->prg_bank_offset = 0;
+    agnes->mirroring_mode = MIRRORING_MODE_SINGLE_LOWER;
+}
+
+static uint8_t mapper7_read(mapper7_t *mapper, uint16_t addr) {
+    const gamepack_t *gp = &mapper->agnes->gamepack;
+    if (addr < 0x2000) {
+        return mapper->chr_ram[addr];
+    } else if (addr >= 0x8000) {
+        unsigned mask = gp->prg_rom_banks_count >= 2 ? 0x7fff : 0x3fff;  /* a 16 KB image is mirrored */
+        return gp->data[gp->prg_rom_offset + mapper->prg_bank_offset + (addr & mask)];
+    }
+    return 0;
+}
+
+static void mapper7_write(mapper7_t *mapper, uint16_t addr, uint8_t val) {
+    if (addr < 0x2000) {
+        mapper->chr_ram[addr] = val;
+    } else if (addr >= 0x8000) {
+        int banks = mapper->agnes->gamepack.prg_rom_banks_count / 2;
+        mapper->prg_bank_offset = (banks > 0 ? (val & 0x7) % banks : 0) * (32 * 1024);
+        mapper->agnes->mirroring_mode = (val & 0x10) ? MIRRORING_MODE_SINGLE_UPPER : MIRRORING_MODE_SINGLE_LOWER;
+    }
+}
